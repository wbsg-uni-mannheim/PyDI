{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Music Release",
  "description": "Schema representing a single music release (album, single, EP).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "title": "Release ID",
      "description": "Unique release identifier",
      "minLength": 1,
      "maxLength": 64,
      "examples": [
        "discogs_3",
        "lastfm_123",
        "musicbrainz_456"
      ]
    },
    "name": {
      "type": "string",
      "title": "Release Name",
      "description": "Title of the release (album, single, or EP name)",
      "minLength": 1,
      "maxLength": 512,
      "examples": [
        "Unreasonable Behaviour",
        "The Sign's Alive"
      ]
    },
    "artist": {
      "type": "string",
      "title": "Artist",
      "description": "Name of the artist or band",
      "minLength": 1,
      "maxLength": 3000,
      "examples": [
        "Laurent Garnier",
        "John B"
      ]
    },
    "release-date": {
      "type": "string",
      "title": "Release Date",
      "format": "date",
      "description": "Release date in ISO 8601 format (YYYY-MM-DD)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "examples": [
        "2000-06-01",
        "1996-01-01"
      ],
      "x-pydi-consistency": {
        "rule": "date_range",
        "description": "Release date range is based on the music input coverage.",
        "minimumDate": "1900-01-01",
        "maximumDate": "2016-12-31"
      }
    },
    "release-country": {
      "type": "string",
      "title": "Release Country",
      "description": "Country where the release was published",
      "minLength": 2,
      "maxLength": 80,
      "examples": [
        "UK",
        "United States of America",
        "France"
      ],
      "x-pydi-consistency": {
        "rule": "country_or_release_market",
        "exhaustive": false,
        "description": "Accepts recognized countries as well as release-market labels such as Europe, UK & US, or USA & Canada."
      }
    },
    "label": {
      "type": "string",
      "title": "Record Label",
      "description": "Record label that published the release",
      "minLength": 1,
      "maxLength": 300,
      "examples": [
        "F Communications",
        "Peacefrog Records"
      ]
    },
    "genre": {
      "type": "string",
      "title": "Genre",
      "description": "Primary genre of the music",
      "x-pydi-taxonomy": "input/schemamatching/Music_Genres_Taxonomy.csv",
      "x-pydi-taxonomy-column": "Genre Name",
      "x-pydi-taxonomy-exhaustive": true,
      "examples": [
        "Electronic",
        "House",
        "Techno"
      ]
    },
    "tracks": {
      "type": "array",
      "title": "Tracks",
      "description": "List of track names on the release",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "examples": [
        [
          "The Man With The Red Face",
          "City Sphere",
          "Dangerous Drive"
        ],
        [
          "Fermats Theorem",
          "Sight Beyond"
        ]
      ]
    },
    "duration": {
      "type": "integer",
      "title": "Duration",
      "description": "Total duration of the release in seconds",
      "minimum": 1,
      "maximum": 86400,
      "x-pydi-target-unit": "s",
      "examples": [
        1671,
        903,
        637
      ],
      "x-pydi-consistency": {
        "rule": "zero_as_missing",
        "description": "Source duration values of 0 should be treated as missing before consistency evaluation."
      }
    }
  },
  "required": [
    "id",
    "name"
  ]
}
